# Template — copy to backend/.env and fill in. Never commit .env.

# ── Gemini (document extraction + Ask Agent) ────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Page resolution sent to the model; 150 reads dense invoices well.
RENDER_DPI=150
# A second independent read that halves confidence where the two disagree (2× cost).
EXTRACTION_SECOND_PASS=false
# Invoices read by Gemini at once; validation and matching still run one at a time, in arrival order.
EXTRACTION_CONCURRENCY=4

# ── Zoho Books ──────────────────────────────────────────────────────────────
# mock = seeded demo organisation (no credentials needed); live = your Zoho org.
ZOHO_MODE=mock
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# India data centre. Use .com / .eu / .com.au equivalents for other regions.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in/books/v3
# Purchase receives need inventory tracking in Zoho; false = 2-way match only.
ZOHO_RECEIVES_ENABLED=true
ZOHO_SYNC_ON_STARTUP=true
ZOHO_WRITE_BILLS=true
# Fallback expense account for non-PO lines, and the bank account payments are made from.
ZOHO_DEFAULT_EXPENSE_ACCOUNT_ID=
ZOHO_PAID_THROUGH_ACCOUNT_ID=

# ── Database ────────────────────────────────────────────────────────────────
# SQLite by default. For PostgreSQL / Cloud SQL any URL form works — it is normalised to asyncpg:
# DATABASE_URL=postgresql://postgres:<password>@localhost:5432/financecommandcenterhub
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── App ─────────────────────────────────────────────────────────────────────
ORG_NAME=GENSTAR NETWORK SOLUTIONS PVT. LTD.
DEFAULT_USER=s.joshi@genstar-demo.in
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=20
# Seconds in-flight invoices get to finish on shutdown (Cloud Run allows 10 after SIGTERM).
SHUTDOWN_GRACE_SECONDS=8
